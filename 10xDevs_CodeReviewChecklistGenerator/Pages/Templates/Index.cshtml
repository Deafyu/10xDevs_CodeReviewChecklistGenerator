@page
@model _10xDevs_CodeReviewChecklistGenerator.Pages.Templates.IndexModel
@{
    ViewData["Title"] = "Templates";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Templates</h1>
    <a class="btn btn-primary" asp-page="/Templates/Create">New template</a>
</div>

@if (Model.Templates.Count == 0)
{
    <div class="alert alert-info">No templates yet.</div>
}
else
{
    <div class="list-group">
        @foreach (var template in Model.Templates)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">@template.Name</div>
                    <div class="text-muted small">Items: @template.ItemCount</div>
                </div>
                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Templates/Edit" asp-route-id="@template.Id">Edit</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@template.Id">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
