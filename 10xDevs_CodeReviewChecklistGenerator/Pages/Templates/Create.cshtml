@page
@model _10xDevs_CodeReviewChecklistGenerator.Pages.Templates.CreateModel
@{
    ViewData["Title"] = "New Template";
}

<h1 class="h3">New Template</h1>

<form method="post">
    <div class="mb-3">
        <label class="form-label" asp-for="Input.Name"></label>
        <input class="form-control" asp-for="Input.Name" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Input.Description"></label>
        <textarea class="form-control" asp-for="Input.Description" rows="2"></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Input.ItemsText">Items (one per line)</label>
        <textarea class="form-control" asp-for="Input.ItemsText" rows="6"></textarea>
        <span asp-validation-for="Input.ItemsText" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save template</button>
    <a class="btn btn-link" asp-page="/Templates/Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
