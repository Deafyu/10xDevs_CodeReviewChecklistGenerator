@page
@model _10xDevs_CodeReviewChecklistGenerator.Pages.Checklists.IndexModel
@{
    ViewData["Title"] = "Checklists";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Checklists</h1>
    <a class="btn btn-primary" asp-page="/Checklists/Create">New checklist</a>
</div>

@if (Model.Checklists.Count == 0)
{
    <div class="alert alert-info">
        No checklists yet. Create your first one.
    </div>
}
else
{
    <div class="list-group">
        @foreach (var checklist in Model.Checklists)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">@checklist.Title</div>
                    <div class="text-muted small">Items: @checklist.ItemCount | Created: @checklist.CreatedAt.ToLocalTime()</div>
                </div>
                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Checklists/Details" asp-route-id="@checklist.Id">Open</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@checklist.Id">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
