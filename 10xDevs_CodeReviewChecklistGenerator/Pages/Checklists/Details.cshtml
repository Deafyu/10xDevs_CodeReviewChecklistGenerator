@page "{id:guid}"
@model _10xDevs_CodeReviewChecklistGenerator.Pages.Checklists.DetailsModel
@{
    ViewData["Title"] = "Checklist";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Title</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="/api/checklists/@Model.Id/export">Export</a>
        <a class="btn btn-outline-secondary" asp-page="/Checklists/Index">Back</a>
    </div>
</div>

<p class="text-muted">Created: @Model.CreatedAt?.ToLocalTime()</p>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-warning">No items yet.</div>
}
else
{
    <form method="post">
        <div class="list-group mb-3">
            @for (var i = 0; i < Model.Items.Count; i++)
            {
                <div class="list-group-item">
                    <div class="d-flex align-items-start gap-2">
                        <input type="hidden" asp-for="Items[i].Id" />
                        <input class="form-check-input mt-1" asp-for="Items[i].IsChecked" />
                        <span>@Model.Items[i].Text</span>
                    </div>
                </div>
            }
        </div>
        <button type="submit" class="btn btn-primary">Save progress</button>
    </form>
}
