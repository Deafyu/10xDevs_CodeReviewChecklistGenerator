@page
@model IndexModel
@{
    ViewData["Title"] = "Checklist Generator";
}

<section class="p-4 p-md-5 rounded-4 bg-white shadow-sm">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <h1 class="display-5 fw-bold">AI-driven code review checklists</h1>
            <p class="lead text-muted">
                Turn any change set into a structured review plan. Paste code before and after,
                add a short description, and get a checklist tailored to your change.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" asp-page="/Checklists/Create">Generate checklist</a>
                <a class="btn btn-outline-secondary" asp-page="/Templates/Index">Manage templates</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="p-4 border rounded-4 bg-light">
                <h2 class="h5 fw-semibold">How it works</h2>
                <ol class="mt-3 mb-0">
                    <li>Paste code before and after the change.</li>
                    <li>Describe the context in one paragraph.</li>
                    <li>Review, edit, check off, and export.</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="mt-4">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="list-group-item">
                <h3 class="h6 fw-semibold">Focused reviews</h3>
                <p class="text-muted mb-0">Every checklist is tailored to the exact diff and description.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="list-group-item">
                <h3 class="h6 fw-semibold">Reusable templates</h3>
                <p class="text-muted mb-0">Save patterns for recurring change types and reuse them.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="list-group-item">
                <h3 class="h6 fw-semibold">Export-ready</h3>
                <p class="text-muted mb-0">Share your review results as a clean text export.</p>
            </div>
        </div>
    </div>
</section>
